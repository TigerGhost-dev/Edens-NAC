<!DOCTYPE html>
<html>
<head>

    <title>Manage Users</title>

    <style>

        body {
            background: #0f172a;
            color: white;
            font-family: Arial;
            padding: 20px;
        }

        h2 {
            margin-bottom: 20px;
        }

        input {
            padding: 8px;
            margin-bottom: 10px;
            width: 280px;
            border-radius: 5px;
            border: none;
        }

        button {
            padding: 8px 14px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #1e293b;
            margin-top: 10px;
        }

        th, td {
            padding: 10px;
            text-align: left;
        }

        th {
            background: #020617;
        }

        tr:nth-child(even) {
            background: #334155;
        }

        .btn {
            padding: 5px 10px;
            text-decoration: none;
            color: white;
            border-radius: 5px;
            margin-right: 5px;
        }

        .delete {
            background: red;
        }

        .approve {
            background: green;
        }

        .approved {
            color: #22c55e;
            font-weight: bold;
        }

        .pending {
            color: #f59e0b;
            font-weight: bold;
        }

        .authenticated {
            color: #22c55e;
            font-weight: bold;
        }

        .offline {
            color: #94a3b8;
        }

        /*
         * Highlighted search result
         */

        .highlight {
            background: #14532d !important;
            box-shadow: inset 0 0 0 2px #22c55e;
        }

        .search-info {
            margin-top: 5px;
            margin-bottom: 15px;
            color: #94a3b8;
        }

    </style>

</head>


<body>

<h2>
    Manage Users & Hosts
</h2>


<form method="GET" action="/users">

    <input
        type="text"
        name="mac"
        value="{{ search_mac }}"
        placeholder="Search by MAC address"
    >

    <button type="submit">
        Search
    </button>

</form>


{% if search_mac %}

<div class="search-info">

    Searching for:
    <strong>{{ search_mac }}</strong>

    {% if users|length == 0 %}
        — No matching device found.
    {% else %}
        — {{ users|length }} result(s) found.
    {% endif %}

</div>

{% endif %}


<table>

    <tr>

        <th>ID</th>

        <th>Username</th>

        <th>MAC</th>

        <th>IP</th>

        <th>Authentication</th>

        <th>Status</th>

        <th>Actions</th>

    </tr>


    {% for u in users %}

    <tr class="{% if search_mac and search_mac|lower in (u[3] or '')|lower %}highlight{% endif %}">

        <td>
            {{ u[0] }}
        </td>

        <td>
            {{ u[1] or '-' }}
        </td>

        <td>
            {{ u[3] or '-' }}
        </td>

        <td>
            {{ u[4] or '-' }}
        </td>

        <td>

            {% if u[5] == 1 %}

                <span class="authenticated">
                    AUTHENTICATED
                </span>

            {% else %}

                <span class="offline">
                    NOT AUTHENTICATED
                </span>

            {% endif %}

        </td>

        <td>

            {% if u[6] == 'approved' %}

                <span class="approved">
                    APPROVED
                </span>

            {% else %}

                <span class="pending">
                    PENDING
                </span>

            {% endif %}

        </td>

        <td>

            <a
                class="btn delete"
                href="/delete_user/{{ u[0] }}"
                onclick="return confirm('Delete this user?');"
            >
                Delete
            </a>


            {% if u[6] != 'approved' %}

            <a
                class="btn approve"
                href="/approve_user/{{ u[0] }}"
            >
                Approve
            </a>

            {% endif %}

        </td>

    </tr>

    {% endfor %}

</table>


</body>
</html>